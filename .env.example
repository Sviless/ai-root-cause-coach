# Copy this file to ".env" to enable LLM Enhanced Mode. Never commit real keys.
# The app runs fully without any of these (Template Engine Mode is the default).

# --- Google Gemini (supported today) ---
# Get a key at https://aistudio.google.com/app/apikey and paste it here.
# Setting GEMINI_API_KEY alone is enough — the provider defaults to "gemini".
GEMINI_API_KEY=

# Optional Gemini model (default: gemini-1.5-flash). Examples:
#   gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash
GEMINI_MODEL=

# --- Generic overrides (optional) ---
# Provider selection: gemini | openai | azure | claude (only gemini is wired up).
LLM_PROVIDER=gemini

# Alternative to GEMINI_API_KEY (used if GEMINI_API_KEY is not set).
LLM_API_KEY=

# Alternative to GEMINI_MODEL.
LLM_MODEL=
