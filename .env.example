# Copy this file to ".env" to prepare LLM Enhanced Mode. Never commit real keys.
# The app runs fully without any of these (Template Engine Mode is the default).

# Enables LLM Enhanced Mode when set to a real key.
LLM_API_KEY=

# Provider-neutral selection for a future integration: openai | azure | claude
LLM_PROVIDER=openai

# Optional model name for a future integration.
LLM_MODEL=
